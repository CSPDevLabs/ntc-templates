Value SYSTEM_NAME (\S+)
Value SYSTEM_TYPE (.+)
Value CHASSIS_TOPOLOGY (\S+)
Value SYSTEM_VERSION (\S+)
Value SYSTEM_CONTACT (.*)
Value SYSTEM_LOCATION (.*)
Value SYSTEM_COORDINATES (.*)
Value SYSTEM_UP_TIME (.+)
Value SYSTEM_UP_TIME_64BIT (.+)
Value CONFIG_MODE_CFG (\S+)
Value CONFIG_MODE_OPER (\S+)
Value LAST_MODE_CHANGED_DATETIME (\d{4}/\d{2}/\d{2}\s+\d{2}:\d{2}:\d{2})
Value LAST_MODE_CHANGED_DURATION (.+)
Value SNMP_PORT (\d+)
Value SNMP_ENGINE_ID (\S+)
Value SNMP_ENGINE_BOOTS (\d+)
Value SNMP_MAX_MESSAGE_SIZE (\d+)
Value SNMP_MAX_BULK_DURATION (\S+)
Value SNMP_ADMIN_STATE (\S+)
Value SNMP_OPER_STATE (\S+)
Value SNMP_INDEX_BOOT_STATUS (\S+)
Value SNMP_SYNC_STATE (\S+)
Value TEL_TEL6_SSH_FTP_ADMIN (.+)
Value TEL_TEL6_SSH_FTP_OPER (.+)
Value BOF_SOURCE (\S+)
Value IMAGE_SOURCE (\S+)
Value CONFIG_SOURCE (\S+)
Value LAST_BOOTED_CONFIG_FILE (.+)
Value LAST_BOOT_CFG_VERSION (\S+)
Value LAST_BOOT_INDEX_VERSION (\S+)
Value LAST_SAVED_CONFIG (\S+)
Value CHANGES_SINCE_LAST_SAVE (\S+)
Value MAX_CFG_BOF_BACKUP_REV (\d+)
Value CFG_OK_SCRIPT (\S+)
Value CFG_OK_SCRIPT_STATUS (.+)
Value CFG_FAIL_SCRIPT (\S+)
Value CFG_FAIL_SCRIPT_STATUS (.+)
Value IPV4_AUTOCONFIGURATION (\S+)
Value IPV6_AUTOCONFIGURATION (\S+)
Value MANAGEMENT_IPV4_ADDR (\S+)
Value PRIMARY_DNS_SERVER (\S+)
Value SECONDARY_DNS_SERVER (\S+)
Value TERTIARY_DNS_SERVER (\S+)
Value DNS_DOMAIN (.+)
Value DNS_RESOLVE_PREFERENCE (\S+)
Value BOF_STATIC_ROUTE_TO (\S+)
Value BOF_STATIC_ROUTE_NEXT_HOP (\S+)
Value ICMP_VENDOR_ENHANCEMENT (\S+)
Value SYSTEM_REBOOT_REQUIRED (\S+)
Value LAST_REBOOT_REASON (\S+)

Start
  ^\s*System Name\s*:\s*${SYSTEM_NAME}
  ^\s*System Type\s*:\s*${SYSTEM_TYPE}
  ^\s*Chassis Topology\s*:\s*${CHASSIS_TOPOLOGY}
  ^\s*System Version\s*:\s*${SYSTEM_VERSION}
  ^\s*System Contact\s*:\s*${SYSTEM_CONTACT}
  ^\s*System Location\s*:\s*${SYSTEM_LOCATION}
  ^\s*System Coordinates\s*:\s*${SYSTEM_COORDINATES}
  ^\s*System Up Time\s*:\s*${SYSTEM_UP_TIME}
  ^\s*System Up Time \(64-bit\)\s*:\s*${SYSTEM_UP_TIME_64BIT}
  ^\s*Configuration Mode Cfg\s*:\s*${CONFIG_MODE_CFG}
  ^\s*Configuration Mode Oper\s*:\s*${CONFIG_MODE_OPER}
  ^\s*Last Mode Changed\s*:\s*${LAST_MODE_CHANGED_DATETIME}\s+Duration:\s*${LAST_MODE_CHANGED_DURATION}
  ^\s*SNMP Port\s*:\s*${SNMP_PORT}
  ^\s*SNMP Engine ID\s*:\s*${SNMP_ENGINE_ID}
  ^\s*SNMP Engine Boots\s*:\s*${SNMP_ENGINE_BOOTS}
  ^\s*SNMP Max Message Size\s*:\s*${SNMP_MAX_MESSAGE_SIZE}
  ^\s*SNMP Max Bulk Duration\s*:\s*${SNMP_MAX_BULK_DURATION}
  ^\s*SNMP Admin State\s*:\s*${SNMP_ADMIN_STATE}
  ^\s*SNMP Oper State\s*:\s*${SNMP_OPER_STATE}
  ^\s*SNMP Index Boot Status\s*:\s*${SNMP_INDEX_BOOT_STATUS}
  ^\s*SNMP Sync State\s*:\s*${SNMP_SYNC_STATE}
  ^\s*Tel/Tel6/SSH/FTP Admin\s*:\s*${TEL_TEL6_SSH_FTP_ADMIN}
  ^\s*Tel/Tel6/SSH/FTP Oper\s*:\s*${TEL_TEL6_SSH_FTP_OPER}
  ^\s*BOF Source\s*:\s*${BOF_SOURCE}
  ^\s*Image Source\s*:\s*${IMAGE_SOURCE}
  ^\s*Config Source\s*:\s*${CONFIG_SOURCE}
  ^\s*Last Booted Config File\s*:\s*${LAST_BOOTED_CONFIG_FILE}
  ^\s*Last Boot Cfg Version\s*:\s*${LAST_BOOT_CFG_VERSION}
  ^\s*Last Boot Index Version\s*:\s*${LAST_BOOT_INDEX_VERSION}
  ^\s*Last Saved Config\s*:\s*${LAST_SAVED_CONFIG}
  ^\s*Changes Since Last Save\s*:\s*${CHANGES_SINCE_LAST_SAVE}
  ^\s*Max Cfg/BOF Backup Rev\s*:\s*${MAX_CFG_BOF_BACKUP_REV}
  ^\s*Cfg-OK Script\s*:\s*${CFG_OK_SCRIPT}
  ^\s*Cfg-OK Script Status\s*:\s*${CFG_OK_SCRIPT_STATUS}
  ^\s*Cfg-Fail Script\s*:\s*${CFG_FAIL_SCRIPT}
  ^\s*Cfg-Fail Script Status\s*:\s*${CFG_FAIL_SCRIPT_STATUS}
  ^\s*IPv4 autoconfiguration\s*:\s*${IPV4_AUTOCONFIGURATION}
  ^\s*IPv6 autoconfiguration\s*:\s*${IPV6_AUTOCONFIGURATION}
  ^\s*Management IPv4 Addr\s*:\s*${MANAGEMENT_IPV4_ADDR}
  ^\s*Primary DNS Server\s*:\s*${PRIMARY_DNS_SERVER}
  ^\s*Secondary DNS Server\s*:\s*${SECONDARY_DNS_SERVER}
  ^\s*Tertiary DNS Server\s*:\s*${TERTIARY_DNS_SERVER}
  ^\s*DNS Domain\s*:\s*${DNS_DOMAIN}
  ^\s*DNS Resolve Preference\s*:\s*${DNS_RESOLVE_PREFERENCE}
  ^\s*${BOF_STATIC_ROUTE_TO}\s+${BOF_STATIC_ROUTE_NEXT_HOP}
  ^\s*ICMP Vendor Enhancement\s*:\s*${ICMP_VENDOR_ENHANCEMENT}
  ^\s*System Reboot Required\s*:\s*${SYSTEM_REBOOT_REQUIRED}
  ^\s*Last Reboot Reason\s*:\s*${LAST_REBOOT_REASON} -> Record
