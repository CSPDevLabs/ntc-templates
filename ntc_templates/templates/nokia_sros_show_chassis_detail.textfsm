Value NAME (.+)
Value TYPE (.+)
Value CHASSIS_TOPOLOGY (.+)
Value LOCATION (.+)
Value COORDINATES (.+)
Value CLLI_CODE (.*)
Value NUMBER_OF_SLOTS (\d+)
Value OPER_NUMBER_OF_SLOTS (\d+)
Value NUM_FACEPLATE_PORTS (\d+)
Value NUM_PHYSICAL_PORTS (\d+)
Value OVER_TEMPERATURE_STATE (.+)
Value BASE_MAC_ADDRESS (\S+)
Value OS_SECURITY_PASSWORD (\S+)
Value ANTI_THEFT_LOCKED (\S+)

Value CHASSIS_STATUS (.+)
Value CHASSIS_ROLE (.+)
Value CHASSIS_HW_PART_NUMBER (.+)
Value CHASSIS_HW_CLEI_CODE (.+)
Value CHASSIS_HW_SERIAL_NUMBER (\S+)
Value CHASSIS_HW_MANUFACTURE_DATE (\S+)
Value CHASSIS_HW_MANUFACTURING_DEVIATIONS (.+)
Value CHASSIS_HW_MANUFACTURING_ASSEMBLY_NUMBER (.+)
Value CHASSIS_HW_TIME_LAST_BOOT (\d{4}/\d{2}/\d{2}\s+\d{2}:\d{2}:\d{2})
Value CHASSIS_HW_CURRENT_ALARM_STATE (.+)

Value NUM_FAN_TRAYS (\d+)
Value FAN_TRAY_NUMBER (\d+)
Value FAN_SPEED (\d+\s*%)
Value FAN_STATUS (.+)

Value NUMBER_OF_POWER_SUPPLIES (\d+)
Value POWER_SUPPLY_NUMBER (\d+)
Value POWER_SUPPLY_TYPE (\S+)
Value POWER_SUPPLY_STATUS (.+)
Value POWER_SUPPLY_INPUT_POWER (.+)
Value POWER_SUPPLY_OUTPUT_POWER (.+)
Value POWER_SUPPLY_OVER_TEMP (.+)

Start
  ^\s*={10,}$
  ^\s*System Information
  ^\s*={10,}$
  ^\s*Name\s+:\s+${NAME}
  ^\s*Type\s+:\s+${TYPE}
  ^\s*Chassis Topology\s+:\s+${CHASSIS_TOPOLOGY}
  ^\s*Location\s+:\s+${LOCATION}
  ^\s*Coordinates\s+:\s+${COORDINATES}
  ^\s*CLLI code\s+:\s+${CLLI_CODE}
  ^\s*Number of slots\s+:\s+${NUMBER_OF_SLOTS}
  ^\s*Oper number of slots\s+:\s+${OPER_NUMBER_OF_SLOTS}
  ^\s*Num of faceplate ports/connectors\s+:\s+${NUM_FACEPLATE_PORTS}
  ^\s*Num of physical ports\s+:\s+${NUM_PHYSICAL_PORTS}
  ^\s*Over Temperature state\s+:\s+${OVER_TEMPERATURE_STATE}
  ^\s*Base MAC address\s+:\s+${BASE_MAC_ADDRESS}
  ^\s*OS-Security Password\s+:\s+${OS_SECURITY_PASSWORD}
  ^\s*Anti-Theft Locked\s+:\s+${ANTI_THEFT_LOCKED}

  ^\s*={10,}$
  ^\s*Chassis 1 Detail
  ^\s*={10,}$
  ^\s*Chassis Status\s+:\s+${CHASSIS_STATUS}
  ^\s*Chassis Role\s+:\s+${CHASSIS_ROLE}
  ^\s*Hardware Data
  ^\s*Part number\s+:\s+${CHASSIS_HW_PART_NUMBER}
  ^\s*CLEI code\s+:\s+${CHASSIS_HW_CLEI_CODE}
  ^\s*Serial number\s+:\s+${CHASSIS_HW_SERIAL_NUMBER}
  ^\s*Manufacture date\s+:\s+${CHASSIS_HW_MANUFACTURE_DATE}
  ^\s*Manufacturing deviations\s+:\s+${CHASSIS_HW_MANUFACTURING_DEVIATIONS}
  ^\s*Manufacturing assembly number\s+:\s+${CHASSIS_HW_MANUFACTURING_ASSEMBLY_NUMBER}
  ^\s*Time of last boot\s+:\s+${CHASSIS_HW_TIME_LAST_BOOT}
  ^\s*Current alarm state\s+:\s+${CHASSIS_HW_CURRENT_ALARM_STATE}

  ^\s*-{10,}$
  ^\s*Environment Information
  ^\s*Number of fan trays\s+:\s+${NUM_FAN_TRAYS}
  ^\s*Fan tray number\s+:\s+${FAN_TRAY_NUMBER}
  ^\s*Speed\s+:\s+${FAN_SPEED}
  ^\s*Status\s+:\s+${FAN_STATUS}

  ^\s*-{10,}$
  ^\s*Power Supply Information
  ^\s*Number of power supplies\s+:\s+${NUMBER_OF_POWER_SUPPLIES}
  ^\s*Power supply number\s+:\s+${POWER_SUPPLY_NUMBER}
  ^\s*Power supply type\s+:\s+${POWER_SUPPLY_TYPE}
  ^\s*Status\s+:\s+${POWER_SUPPLY_STATUS}
  ^\s*Input power\s+:\s+${POWER_SUPPLY_INPUT_POWER}
  ^\s*Output power\s+:\s+${POWER_SUPPLY_OUTPUT_POWER}
  ^\s*Over temp\s+:\s+${POWER_SUPPLY_OVER_TEMP} -> Record
