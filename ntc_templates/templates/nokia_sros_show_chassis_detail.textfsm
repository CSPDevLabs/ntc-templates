  ^\s*FP Generations\s*:\s*${FP_GENERATIONS}\s*$$
  ^\s*System Profile\s*:\s*${SYSTEM_PROFILE}\s*$$
  ^\s*={79}$$
  ^\s*Chassis 1 Detail\s*$$
  ^\s*={79}$$
  ^\s*Chassis Status\s*:\s*${CHASSIS_STATUS}\s*$$
  ^\s*Chassis Role\s*:\s*${CHASSIS_ROLE}\s*$$
  ^\s*Hardware Data\s*$$
  ^\s*Part number\s*:\s*${CHASSIS_HW_PART_NUMBER}\s*$$
  ^\s*CLEI code\s*:\s*${CHASSIS_HW_CLEI_CODE}\s*$$
  ^\s*Serial number\s*:\s*${CHASSIS_HW_SERIAL_NUMBER}\s*$$
  ^\s*Manufacture date\s*:\s*${CHASSIS_HW_MANUFACTURE_DATE}\s*$$
  ^\s*Manufacturing deviations\s*:\s*${CHASSIS_HW_MANUFACTURING_DEVIATIONS}\s*$$
  ^\s*Manufacturing assembly number\s*:\s*${CHASSIS_HW_MANUFACTURING_ASSEMBLY_NUMBER}\s*$$
